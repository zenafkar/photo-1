PORT=5000

# Neon PostgreSQL Connection String (get from Neon dashboard)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Clerk Authentication Keys (From Clerk Dashboard)
CLERK_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"
CLERK_SECRET_KEY="sk_test_your_secret_key_here"
CLERK_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# AI Provider Keys
REPLICATE_API_TOKEN="r8_your_token_here"

# AI SRE Agent Configuration
GEMINI_API_KEY="your_gemini_key_here"

# GitHub (for auto-issue creation)
GITHUB_TOKEN="github_pat_your_token_here"

# Telegram Bot Integration
# Token khusus bot SRE server (webhook). WAJIB berbeda dari token deploy-bot
# yang disimpan di deploy-bot/.env dan berjalan dengan long polling.
TELEGRAM_SRE_BOT_TOKEN="123456789:AAFxXxxXXXX_SREOnlyToken"
# Alias kompatibilitas untuk environment lama; jangan gunakan token deploy-bot di sini.
# TELEGRAM_BOT_TOKEN="123456789:AAFxXxxXXXX_SREOnlyToken"
TELEGRAM_CHAT_ID="987654321"
TELEGRAM_REPORT_LEVEL="WARNING_AND_ABOVE" # ALL or WARNING_AND_ABOVE
TELEGRAM_ADMIN_CHAT_IDS="987654321"
# Optional for private chats; required when an admin chat is a group.
TELEGRAM_ADMIN_USER_IDS="987654321"
# Telegram webhook secret token, not a bot token. Use 1–256 chars: A-Z, a-z, 0-9, _, -.
TELEGRAM_WEBHOOK_SECRET="replace-with-a-random-secret"
DOMAIN="https://zenstudio.my.id"

# Xendit Payment Gateway
XENDIT_API_KEY="xnd_development_your_api_key_here"
XENDIT_WEBHOOK_TOKEN="your_webhook_callback_token_here"
XENDIT_IS_PRODUCTION=false

# FEATURE FLAGS: Agent Capabilities (true/false)
ENABLE_AUTO_RESTART_PM2=true
ENABLE_AUTO_GITHUB_ISSUE=true
ENABLE_CACHE_FLUSH=true

# AUTO GIT PUSH TO MASTER CONFIGURATION
ENABLE_AUTO_GIT_PUSH=false
REQUIRE_APPROVAL_FOR_GIT_PUSH=true

# Optional — model selection and URL overrides (defaults are safe)
# GEMINI_MODEL="gemini-2.0-flash"
# CLERK_AUTHORIZED_PARTIES=""
# BACKEND_URL="http://localhost:5000"
