# ==========================================
# Deploy Bot ZenDev - Contoh Konfigurasi
# 1. Salin file ini menjadi ".env" (tanpa "example")
# 2. Isi nilainya. JANGAN commit file ".env".
# ==========================================

# Token bot Telegram BARU dari @BotFather (wajib bot terpisah dari bot SRE
# yang sudah polling token lain di server).
TELEGRAM_BOT_TOKEN=

# Telegram user ID yang boleh menjalankan /deploy (dipisah koma).
# Cek ID Anda dengan @userinfobot. Wajib diisi.
ALLOWED_USER_IDS=

# Detail VPS
VPS_IP=160.19.166.129
VPS_USER=zen-deploy
VPS_LOCAL=true
VPS_TARGET_DIR=/var/www/zen-dev

# Lokasi repo di VPS (WAJIB diisi saat bot jalan di VPS, karena bot dir berada
# di /opt/zen-deploy-bot dan repo sebenarnya ada di /var/www/zen-dev).
REPO_DIR=/var/www/zen-dev
TARGET_DIR=/var/www/zen-dev

# Lokasi absolute deploy script. Jangan gunakan salinan lokal/untracked.
DEPLOY_SCRIPT=/var/www/zen-dev/scripts/deploy.sh

# Lock, logs, and backups shared by the bot and scripts/deploy.sh on Linux.
DEPLOY_LOCK_PATH=/run/zen-deploy/deploy.lock
DEPLOY_LOG_DIR=/var/lib/zen-deploy/logs
DEPLOY_BACKUP_DIR=/var/lib/zen-deploy/backups
DEPLOY_DATABASE_BACKUP_DIR=/var/lib/zen-deploy/database-backups

# Runtime paths used by the non-root service and PM2.
PM2_HOME=/var/lib/zen-deploy/pm2
PM2_LOG_ROOT=/var/lib/zen-deploy/pm2/logs
PM2_BIN=/usr/bin/pm2
NODE_BIN=/usr/bin/node

# Health gates. Both local and public readiness endpoints must return HTTP 200.
HEALTH_URL=http://localhost:5000/api/v1/health/ready
EXTERNAL_HEALTH_URL=https://zenstudio.my.id/api/v1/health/ready
DEPLOY_HEALTH_RETRIES=6
DEPLOY_HEALTH_INTERVAL=5
