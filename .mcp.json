{
  "mcpServers": {
    "secretary": {
      "type": "stdio",
      "command": "python",
      "args": [
        "agent-secretary/mcp_server.py"
      ],
      "env": {
        "SECRETARY_AUTH_TOKEN": "${SECRETARY_AUTH_TOKEN}",
        "SECRETARY_WEBHOOK_URL": "${SECRETARY_WEBHOOK_URL}"
      }
    }
  }
}